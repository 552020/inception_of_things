Vagrant.configure("2") do |config|
  # ✅ Super lightweight Alpine Linux base box
  config.vm.box = "generic/alpine318"

  # (Optional) Give VM a bit more resources
  config.vm.provider "virtualbox" do |vb|
    vb.name   = "alpine-minimal"
    vb.memory = 512
    vb.cpus   = 1
  end

  # ✅ Install basic tools: vim and curl (called 'vim' + 'curl' in Alpine too)
  config.vm.provision "shell", inline: <<-SHELL
    echo "Updating Alpine and installing tools..."
    apk update
    apk add vim curl
    echo "Done! Alpine is ready 🚀"
  SHELL
end

