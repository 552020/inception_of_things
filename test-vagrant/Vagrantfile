# Vagrantfile
Vagrant.configure("2") do |config|
  config.vm.box = "generic/alpine318"   # has libvirt builds available

  config.vm.provider :libvirt do |lv|
    lv.memory = 512
    lv.cpus   = 1
  end

  # keep it tiny; rsync will handle /vagrant by default on libvirt
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apk update
    apk add --no-cache vim curl
    echo "Ready."
  SHELL
end

