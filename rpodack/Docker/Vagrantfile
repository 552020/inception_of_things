# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.provider "docker" do |d|
    d.privileged = true
    d.remains_running = true
    d.cmd = ["tail", "-f", "/dev/null"]
  end

  # --- K3s Server Node ---
  config.vm.define "rpodackS" do |s|
    s.vm.provider "docker" do |d|
      d.image = "ubuntu:22.04"
      d.name  = "rpodackS"
      d.privileged = true
    end

    s.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y curl sudo iptables
      curl -sfL https://get.k3s.io -o install_k3s.sh
      chmod +x install_k3s.sh
      INSTALL_K3S_SKIP_ENABLE=true INSTALL_K3S_EXEC="server --write-kubeconfig-mode 644 --node-name rpodackS" ./install_k3s.sh
      nohup /usr/local/bin/k3s server --write-kubeconfig-mode 644 --node-name rpodackS >/k3s-server.log 2>&1 &
      sleep 10
      cat /var/lib/rancher/k3s/server/node-token > /node-token
    SHELL
  end

  # --- K3s Worker Node ---
  config.vm.define "rpodackSW" do |w|
    w.vm.provider "docker" do |d|
      d.image = "ubuntu:22.04"
      d.name  = "rpodackSW"
      d.privileged = true
    end

    w.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y curl sudo iptables
      SERVER_IP=$(getent hosts rpodackS | awk '{ print $1 }')
      TOKEN=$(cat /node-token 2>/dev/null || echo "notoken")
      if [ "$TOKEN" = "notoken" ]; then
        echo "⚠️ Server token not yet available; start server first"
        exit 1
      fi
      curl -sfL https://get.k3s.io -o install_k3s.sh
      chmod +x install_k3s.sh
      INSTALL_K3S_SKIP_ENABLE=true ./install_k3s.sh
      nohup /usr/local/bin/k3s agent --server https://$SERVER_IP:6443 --token $TOKEN --node-name rpodackSW >/k3s-agent.log 2>&1 &
    SHELL
  end
end


